# Telegram-bot authorization for the r.avaflow web app.
# Copy this file to .env in the SAME directory as docker-compose.yml and fill
# in real values. Leave TG_AUTH_SECRET empty to disable authorization
# completely (legacy open mode — the app then behaves exactly as before).

# Shared HMAC secret for login tokens and session cookies.
# MUST be identical on classic and 40G containers.
# Generate: openssl rand -hex 32
TG_AUTH_SECRET=

# Telegram user ids with admin rights (see ALL users' projects, grouped by
# user, can change container CPU limits and stop foreign simulations).
TG_ADMIN_IDS=1049276038,262857249

# Bot handle without @ — used to build t.me login links.
TG_BOT_USERNAME=web_r_avaflow_bot

# Bot token from @BotFather. Needed on ONE container only (it polls
# getUpdates and mints login tokens); other containers only verify tokens
# using TG_AUTH_SECRET, so they can share this value harmlessly.
TG_BOT_TOKEN=

# Optional registration allowlist (comma-separated Telegram ids).
# Empty = anyone who reaches the bot can register. Admins always allowed.
TG_ALLOWED_IDS=
